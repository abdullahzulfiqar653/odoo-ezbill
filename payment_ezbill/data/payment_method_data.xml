<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_ezbill" model="payment.method">
        <field name="name">Raast QR</field>
        <field name="code">ezbill</field>
        <field name="sequence">1000</field>
        <field name="image" type="base64" file="payment_ezbill/static/img/ezbill.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.pk')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.PKR')])]"/>
    </record>

</odoo>
